  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Failover Redis",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "expr": "{service=\"sentinel-1\"} |= \"+switch-master\"",
        "target": {
          "expr": "{service=\"sentinel-1\"} |= \"+switch-master\"",
          "refId": "Anno"
        },
        "titleFormat": "Failover",
        "textFormat": "{{__line__}}"
      }
    ]
  },
  "panels": [
