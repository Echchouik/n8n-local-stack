      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(redis_db_keys{job=\"redis\"} * on (instance) group_left () redis_instance_info{job=\"redis\", role=\"master\"})",
