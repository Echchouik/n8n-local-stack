# Copié en .env par scripts/setup.sh (secrets générés automatiquement). Ne jamais commiter .env.

# --- Postgres ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=__GENERATED__
POSTGRES_DB=n8n

# --- Redis HA (3 nœuds + 3 sentinelles + HAProxy) ---
# Même mot de passe pour les nœuds, les sentinelles et le check HAProxy
REDIS_PASSWORD=__GENERATED__
REDIS_VERSION=7-alpine
HAPROXY_VERSION=3.2-alpine

# --- n8n ---
# Clé de chiffrement des credentials : la garder si tu réutilises une base existante
N8N_ENCRYPTION_KEY=__GENERATED__
N8N_VERSION=latest
WORKER_CONCURRENCY=5
GENERIC_TIMEZONE=Europe/Paris

# --- Ports publiés sur l'hôte ---
# Identiques sur tous les moteurs (Podman rootless refuse < 1024).
# Si tu changes HTTPS_PORT, adapte aussi nginx/nginx.conf (redirection + listen 8443)
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=__GENERATED__
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
LOKI_VERSION=latest
ALLOY_VERSION=latest
POSTGRES_EXPORTER_VERSION=latest
REDIS_EXPORTER_VERSION=latest
NGINX_EXPORTER_VERSION=latest

# --- Alerting Telegram (OBLIGATOIRE : Grafana ne démarre pas si vide) ---
# Token : fourni par @BotFather (/newbot)
# Chat ID : envoyer un message au bot, puis ouvrir
#   https://api.telegram.org/bot<TOKEN>/getUpdates  -> champ "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Socket API Docker-compatible du moteur, vu depuis les conteneurs (rempli par setup.sh) ---
#   Docker Desktop (macOS) / Docker Engine : /var/run/docker.sock
#   Podman rootless (Linux/WSL)            : /run/user/<uid>/podman/podman.sock
CONTAINER_SOCKET=
